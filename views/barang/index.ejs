<%- include("../layouts/header") %>
    <%- include("../layouts/navbar") %>
        <%- include("../layouts/sidebar") %>

            <div class="content-wrapper">

                <section class="content-header">
                    <div class="container-fluid">

                        <div class="d-flex justify-content-between align-items-center">

                            <h3 class="fw-bold">
                                <i class="bi bi-box-seam"></i>
                                Data Barang
                            </h3>

                            <% if (
    currentUser.role === "BuzChef" ||
    currentUser.role === "Head BuzChef" ||
    currentUser.role === "Original Gangster"
) { %>

    <button
        class="btn btn-primary mt-3 mb-3"
        data-bs-toggle="modal"
        data-bs-target="#modalTambah"
    >
        <i class="bi bi-plus-circle"></i>
        Tambah Barang
    </button>

<% } %>

                        </div>

                    </div>
                </section>

                <section class="content">

                    <div class="container-fluid">

                        <div class="card shadow">

                            <div class="card-body">
                                <% if(success){ %>
                                    <div class="alert alert-success alert-dismissible fade show">
                                        <i class="bi bi-check-circle"></i>
                                        <%= success %>

                                            <button class="btn-close" data-bs-dismiss="alert">
                                            </button>
                                    </div>
                                    <% } %>

                                        <% if(error){ %>
                                            <div class="alert alert-danger alert-dismissible fade show">
                                                <i class="bi bi-exclamation-triangle"></i>
                                                <%= error %>

                                                    <button class="btn-close" data-bs-dismiss="alert">
                                                    </button>
                                            </div>
                                            <% } %>
                                                <table class="table table-bordered table-hover" id="tableBarang">

                                                    <thead class="table-primary">

                                                        <tr>

                                                            <th width="60">No</th>
                                                            <th>Nama Barang</th>
                                                            <th>Type</th>
                                                            <th>Stok</th>
                                                            <th>Status</th>
                                                            <th>Dibuat</th>
                                                            <% if (
    currentUser.role === "BuzChef" ||
    currentUser.role === "Head BuzChef" ||
    currentUser.role === "Original Gangster"
) { %>

    <th width="220">Aksi</th>

<% } %>

                                                        </tr>

                                                    </thead>

                                                    <tbody>

                                                        <% barang.forEach(item=>{ %>

                                                            <tr>

                                                                <td>

                                                                </td>

                                                                <td>
                                                                    <%= item.nama %>
                                                                </td>

                                                                <td>
                                                                    <%= item.type %>
                                                                </td>

                                                                <td>
                                                                    <%= item.stok %>
                                                                </td>

                                                                <td>

                                                                    <% if(item.status==="Aktif" ){ %>

                                                                        <span class="badge bg-success">Aktif</span>

                                                                        <% }else if(item.status==="Kosong" ){ %>

                                                                            <span
                                                                                class="badge bg-warning text-dark">Kosong</span>

                                                                            <% }else{ %>

                                                                                <span class="badge bg-danger">
                                                                                    <%= item.status %>
                                                                                </span>

                                                                                <% } %>

                                                                </td>

                                                                <td>
                                                                    <%= item.dibuat %>
                                                                </td>

                                                                <% if (
    currentUser.role === "BuzChef" ||
    currentUser.role === "Head BuzChef" ||
    currentUser.role === "Original Gangster"
) { %>

    <td>

        <!-- EDIT -->
        <button
            class="btn btn-warning btn-sm btnEdit"
            data-id="<%= item.id %>"
            data-nama="<%= item.nama %>"
            data-type="<%= item.type %>"
            data-stok="<%= item.stok %>"
            data-status="<%= item.status %>"
            data-bs-toggle="modal"
            data-bs-target="#modalEdit"
        >
            <i class="bi bi-pencil-square"></i>
        </button>


        <!-- DEPOSIT -->
        <button
            class="btn btn-success btn-sm btnDeposit"
            data-id="<%= item.id %>"
            data-nama="<%= item.nama %>"
            data-stok="<%= item.stok %>"
            data-bs-toggle="modal"
            data-bs-target="#modalDeposit"
        >
            <i class="bi bi-plus-circle"></i>
        </button>


        <!-- PENARIKAN -->
        <button
            class="btn btn-danger btn-sm btnPenarikan"
            data-id="<%= item.id %>"
            data-nama="<%= item.nama %>"
            data-stok="<%= item.stok %>"
            data-bs-toggle="modal"
            data-bs-target="#modalPenarikan"
        >
            <i class="bi bi-dash-circle"></i>
        </button>


        <!-- DELETE -->
        <form
            action="/barang/delete/<%= item.id %>"
            method="POST"
            class="formDelete d-inline formSubmit"
        >

            <button class="btn btn-secondary btn-sm">
                <i class="bi bi-trash"></i>
            </button>

        </form>

    </td>

<% } %>

                                                            </tr>

                                                            <% }) %>

                                                    </tbody>

                                                </table>

                            </div>

                        </div>

                    </div>

                </section>

            </div>
<% if (
    currentUser.role === "BuzChef" ||
    currentUser.role === "Head BuzChef" ||
    currentUser.role === "Original Gangster"
) { %>
            <!-- Modal Tambah -->

            <div class="modal fade" id="modalTambah">

                <div class="modal-dialog">

                    <form class="formSubmit" action="/barang/tambah" method="POST">

                        <div class="modal-content">

                            <div class="modal-header">

                                <h5>Tambah Barang</h5>

                                <button class="btn-close" data-bs-dismiss="modal"></button>

                            </div>

                            <div class="modal-body">

                                <div class="mb-3">

                                    <label>Nama Barang</label>

                                    <input name="nama" class="form-control" required>

                                </div>
                                <div class="mb-3">

                                    <label>Type</label>

                                    <select name="type" class="form-select" required>

                                        <option value="" selected disabled>Silakan Pilih Type Barang</option>

                                        <% types.forEach(item=> { %>

                                            <option value="<%= item.nama %>">
                                                <%= item.nama %>
                                            </option>

                                            <% }) %>

                                    </select>

                                </div>

                                <div class="mb-3">

                                    <label>Stok Awal</label>

                                    <input type="number" name="stok" class="form-control" required>

                                </div>

                            </div>

                            <div class="modal-footer">

                                <button class="btn btn-primary">

                                    Simpan

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>


            <!-- MODAL EDIT -->
            <div class="modal fade" id="modalEdit" tabindex="-1">

                <div class="modal-dialog">

                    <form class="formSubmit" id="formEdit" method="POST">

                        <div class="modal-content">

                            <div class="modal-header">

                                <h5 class="modal-title">Edit Barang</h5>

                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

                            </div>

                            <div class="modal-body">

                                <div class="mb-3">
                                    <label>Nama Barang</label>
                                    <input id="editNama" name="nama" class="form-control" required>
                                </div>

                                <div class="mb-3">
                                    <label>Type</label>

                                    <select id="editType" name="type" class="form-select" required>

                                        <% types.forEach(type=> { %>

                                            <option value="<%= type.nama %>">
                                                <%= type.nama %>
                                            </option>

                                            <% }) %>

                                    </select>

                                </div>

                                <div class="mb-3">
                                    <label>Status</label>

                                    <select id="editStatus" name="status" class="form-select">

                                        <option value="Aktif">Aktif</option>
                                        <option value="Nonaktif">Nonaktif</option>

                                    </select>

                                </div>

                            </div>

                            <div class="modal-footer">

                                <button type="submit" class="btn btn-primary btnSimpan">
                                    Simpan
                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>


            <!-- MODAL DEPOSIT -->
            <div class="modal fade" id="modalDeposit">

                <div class="modal-dialog">

                    <form class="formSubmit" id="formDeposit" method="POST">

                        <div class="modal-content">

                            <div class="modal-header">

                                <h5>Deposit Stok</h5>

                                <button class="btn-close" data-bs-dismiss="modal"></button>

                            </div>

                            <div class="modal-body">

                                <div class="alert alert-primary">

                                    <b id="depositNama"></b>

                                </div>

                                <div class="mb-3">

                                    <label>Jumlah Sekarang</label>

                                    <input type="number" name="depositStok" class="form-control" id="depositStok"
                                        disabled>

                                </div>

                                <div class="mb-3">

                                    <label>Jumlah Deposit</label>

                                    <input type="number" name="jumlah" class="form-control" min="1" required>

                                </div>

                                <div class="mb-3">

                                    <label>Keterangan</label>

                                    <textarea name="keterangan" class="form-control" rows="3"
                                        placeholder="Contoh: Barang datang dari supplier"></textarea>

                                </div>

                            </div>

                            <div class="modal-footer">

                                <button class="btn btn-success">

                                    <i class="bi bi-plus-circle"></i>

                                    Simpan

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>


            <!-- MODAL TARIK -->
            <div class="modal fade" id="modalPenarikan">

                <div class="modal-dialog">

                    <form class="formSubmit" id="formPenarikan" method="POST">

                        <div class="modal-content">

                            <div class="modal-header">

                                <h5>Penarikan Stok</h5>

                                <button class="btn-close" data-bs-dismiss="modal"></button>

                            </div>

                            <div class="modal-body">

                                <div class="alert alert-danger">

                                    <b id="penarikanNama"></b>

                                    <br>

                                    Stok Saat Ini :
                                    <b id="stokSekarang"></b>

                                </div>

                                <div class="mb-3">

                                    <label>Jumlah Penarikan</label>

                                    <input type="number" name="jumlah" min="1" class="form-control" required>

                                </div>

                                <div class="mb-3">

                                    <label>Keterangan</label>

                                    <textarea name="keterangan" rows="3" class="form-control"
                                        placeholder="Contoh : Dipakai Produksi"></textarea>

                                </div>

                            </div>

                            <div class="modal-footer">

                                <button class="btn btn-danger">

                                    <i class="bi bi-dash-circle"></i>

                                    Tarik Stok

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>
            <% } %>

            <%- include("../layouts/data") %>

                <!-- Paling terakhir -->
                <script src="/js/barang.js"></script>

                <%- include("../layouts/footer") %>