<%- include("../layouts/header") %>
<%- include("../layouts/navbar") %>
<%- include("../layouts/sidebar") %>

    <div class="content-wrapper">

        <section class="content-header">

            <div class="container-fluid">

                <div class="d-flex justify-content-between align-items-center mt-3 mb-3">

                    <h3>

                        <i class="bi bi-receipt"></i>

                        Transaksi

                    </h3>

                    <a href="/transaksi/tambah" class="btn btn-primary">

                        <i class="bi bi-plus-circle"></i>

                        Tambah Transaksi

                    </a>

                </div>

            </div>

        </section>

        <section class="content">

            <div class="container-fluid">

                <div class="mb-3">

                    <input type="text" id="searchTransaksi" class="form-control"
                        placeholder="Cari transaksi...">

                </div>

                <div class="row">

                    <% transaksi.forEach(item=>{ %>

                        <div class="col-lg-4 col-md-6 transaksiCard">

                            <div class="card shadow-sm border-0">

                                <div class="card-header d-flex justify-content-between">

                                    <strong>

                                        <%= item.no %>

                                    </strong>

                                    <% if(item.status=="Pending" ){ %>

                                        <span class="badge bg-warning">

                                            Pending

                                        </span>

                                        <% } %>

                                            <% if(item.status=="Diproses" ){ %>

                                                <span class="badge bg-info">

                                                    Diproses

                                                </span>

                                                <% } %>

                                                    <% if(item.status=="Selesai" ){ %>

                                                        <span class="badge bg-success">

                                                            Selesai

                                                        </span>

                                                        <% } %>

                                                            <% if(item.status=="Batal" ){ %>

                                                                <span class="badge bg-danger">

                                                                    Batal

                                                                </span>

                                                                <% } %>

                                </div>

                                <div class="card-body">

                                    <table class="table table-borderless table-sm">

                                        <tr>

                                            <td width="110">

                                                Kelompok

                                            </td>

                                            <td>

                                                <%= item.kelompok %>

                                            </td>

                                        </tr>

                                        <tr>

                                            <td>

                                                Jenis

                                            </td>

                                            <td>

                                                <%= item.jenis %>

                                            </td>

                                        </tr>

                                        <tr>

                                            <td>

                                                Tanggal

                                            </td>

                                            <td>

                                                <%= item.tanggal %>

                                            </td>

                                        </tr>

                                        <tr>

                                            <td>

                                                Total

                                            </td>

                                            <td>

                                                <strong>

                                                    Rp <%= item.total.toLocaleString("id-ID") %>

                                                </strong>

                                            </td>

                                        </tr>

                                    </table>

                                </div>

                                <div class="card-footer d-flex justify-content-between">

                                    <a href="/transaksi/<%= item.no %>" class="btn btn-info btn-sm">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <button class="btn btn-warning btn-sm">

                                        <i class="bi bi-pencil"></i>

                                    </button>

                                    <form action="/transaksi/selesai/<%= item.no %>" method="POST"
                                        class="formSelesai">

                                        <button class="btn btn-success btn-sm">

                                            <i class="bi bi-check-circle"></i>

                                        </button>

                                    </form>

                                    <form action="/transaksi/hapus/<%= item.no %>" method="POST"
                                        class="formDelete">

                                        <button class="btn btn-danger btn-sm">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                        <% }) %>

                </div>

            </div>

        </section>

    </div>

<%- include("../layouts/data") %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/transaksi.js"></script>

<%- include("../layouts/footer") %>