<%- include("../layouts/header") %>
<%- include("../layouts/sidebar") %>
<%- include("../layouts/navbar") %>

<section class="content-header">

<div class="container-fluid">

<h3>Tambah Transaksi</h3>

</div>

</section>

<section class="content">

<div class="container-fluid">

<form action="/transaksi/tambah" method="POST">

<div class="card">

<div class="card-body">

<div class="row">

<div class="col-md-6">

<label>Jenis</label>

<select
class="form-select"
name="jenis"
id="jenis">

<option value="Penjualan">
Penjualan
</option>

<option value="Pembelian">
Pembelian
</option>

</select>

</div>

<div class="col-md-6">

<label>Kelompok</label>

<select
class="form-select"
name="kelompok"
id="kelompok">

<option value="">
Pilih Kelompok
</option>

<% harga.forEach(item=>{ %>

<option value="<%= item.nama %>">

<%= item.nama %>

</option>

<% }) %>

</select>

</div>

</div>

<hr>

<div id="barangContainer">

<div class="alert alert-info">

Pilih kelompok terlebih dahulu.

</div>

</div>

<div class="mt-3">

<label>Keterangan</label>

<textarea
class="form-control"
name="keterangan"></textarea>

</div>

<hr>

<div class="d-flex justify-content-between">

<h3>

TOTAL

Rp <span id="grandTotal">0</span>

</h3>

<button
class="btn btn-success">

Simpan

</button>

</div>

</div>

</div>

</form>

</div>

</section>

</div>

<%- include("../layouts/data") %>

<script>

    const DATA = <%- JSON.stringify(harga) %>;

</script>

<script src="/js/transaksi-create.js"></script>

<%- include("../layouts/footer") %>
