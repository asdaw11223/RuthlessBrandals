<%- include("../layouts/header") %>
<%- include("../layouts/sidebar") %>

<div class="content">

    <%- include("../layouts/navbar") %>

    <div class="container-fluid mt-3">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h3>

                <i class="bi bi-cash-stack"></i>

                Dirty

            </h3>

            <button
                class="btn btn-success"
                data-bs-toggle="modal"
                data-bs-target="#modalTambah">

                <i class="bi bi-plus-circle"></i>

                Tambah Transaksi

            </button>

        </div>

        <!-- SUMMARY -->

        <div class="row">

            <div class="col-lg-3 col-md-6">

                <div class="small-box bg-primary">

                    <div class="inner">

                        <h3>
                            Rp <%= Number(summary.saldo).toLocaleString("id-ID") %>
                        </h3>

                        <p>Saldo Saat Ini</p>

                    </div>

                    <div class="icon">

                        <i class="bi bi-wallet2"></i>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="small-box bg-success">

                    <div class="inner">

                        <h3>

                            Rp <%= Number(summary.masuk).toLocaleString("id-ID") %>

                        </h3>

                        <p>Total Masuk</p>

                    </div>

                    <div class="icon">

                        <i class="bi bi-arrow-down-circle"></i>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="small-box bg-danger">

                    <div class="inner">

                        <h3>

                            Rp <%= Number(summary.keluar).toLocaleString("id-ID") %>

                        </h3>

                        <p>Total Keluar</p>

                    </div>

                    <div class="icon">

                        <i class="bi bi-arrow-up-circle"></i>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="small-box bg-info">

                    <div class="inner">

                        <h3>

                            <%= summary.transaksi %>

                        </h3>

                        <p>Total Transaksi</p>

                    </div>

                    <div class="icon">

                        <i class="bi bi-receipt"></i>

                    </div>

                </div>

            </div>

        </div>

        <!-- TABLE -->

        <div class="card shadow">

            <div class="card-header">

                <h5 class="mb-0">

                    Riwayat Dirty

                </h5>

            </div>

            <div class="card-body">

                <table
                    id="dirtyTable"
                    class="table table-bordered table-hover">

                    <thead>

                        <tr>

                            <th>ID</th>

                            <th>Tanggal</th>

                            <th>Jenis</th>

                            <th>Kelompok</th>

                            <th>Masuk</th>

                            <th>Keluar</th>

                            <th>Saldo</th>

                            <th>Keterangan</th>

                            <th>User</th>

                            <th width="80">Aksi</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% data.forEach(item=>{ %>

                            <tr>

                                <td><%= item.id %></td>

                                <td><%= item.tanggal %></td>

                                <td><%= item.jenis %></td>

                                <td><%= item.kelompok %></td>

                                <td class="text-success">

                                    Rp <%= Number(item.masuk).toLocaleString("id-ID") %>

                                </td>

                                <td class="text-danger">

                                    Rp <%= Number(item.keluar).toLocaleString("id-ID") %>

                                </td>

                                <td>

                                    Rp <%= Number(item.saldo).toLocaleString("id-ID") %>

                                </td>

                                <td><%= item.keterangan %></td>

                                <td><%= item.user %></td>

                                <td>

                                    <form
                                        method="POST"
                                        action="/dirty/delete/<%= item.id %>"
                                        class="formDelete">

                                        <button
                                            class="btn btn-danger btn-sm">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </form>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<!-- ========================= -->
<!-- MODAL TAMBAH -->
<!-- ========================= -->

<div class="modal fade" id="modalTambah">

    <div class="modal-dialog">

        <form action="/dirty/tambah" method="POST">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">

                        Tambah Transaksi Dirty

                    </h5>

                    <button
                        class="btn-close"
                        data-bs-dismiss="modal"
                        type="button">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="mb-3">

                        <label>Jenis</label>

                        <select
                            class="form-select"
                            id="jenis"
                            name="jenis">

                            <option value="Saldo Awal">Saldo Awal</option>
                            <option value="Pemasukan">Pemasukan</option>
                            <option value="Pengeluaran">Pengeluaran</option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label>Kelompok</label>

                        <input
                            class="form-control"
                            name="kelompok"
                            required>

                    </div>

                    <div class="mb-3">

                        <label>Nominal</label>

                        <input
                            id="nominal"
                            class="form-control"
                            type="number"
                            min="0"
                            required>

                    </div>

                    <!-- Akan diisi otomatis -->
                    <input
                        type="hidden"
                        id="masuk"
                        name="masuk">

                    <input
                        type="hidden"
                        id="keluar"
                        name="keluar">

                    <div class="mb-3">

                        <label>Keterangan</label>

                        <textarea
                            class="form-control"
                            name="keterangan"></textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button
                        class="btn btn-success">

                        Simpan

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>

<%- include("../layouts/data") %>

<!-- Paling terakhir -->
<script src="/js/dirty.js"></script>

<%- include("../layouts/footer") %>
