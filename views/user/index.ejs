<%- include("../layouts/header") %>
<%- include("../layouts/sidebar") %>

<div class="content">

    <%- include("../layouts/navbar") %>

    <div class="container-fluid mt-3">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2 class="mb-0">
                <i class="bi bi-people"></i>
                User Management
            </h2>

            <% if (currentUser.role === "Original Gangster") { %>

                <a href="/user/create" class="btn btn-primary">
                    <i class="bi bi-person-plus"></i>
                    Tambah User
                </a>

            <% } %>

        </div>


        <!-- INFO ROLE -->
        <div class="alert alert-info">

            <i class="bi bi-shield-check"></i>

            Login sebagai:

            <strong>
                <%= currentUser.role %>
            </strong>

        </div>


        <!-- TABLE -->
        <div class="card">

            <div class="card-header">

                <strong>
                    <i class="bi bi-people"></i>
                    Daftar User
                </strong>

            </div>


            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-bordered table-striped align-middle">

                        <thead>

                            <tr>

                                <th style="width:70px;">
                                    No
                                </th>

                                <th>
                                    Username
                                </th>

                                <th>
                                    Role
                                </th>

                                <th style="width:400px;">
                                    Aksi
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% if (!users || users.length === 0) { %>

                                <tr>

                                    <td
                                        colspan="4"
                                        class="text-center text-muted"
                                    >

                                        <i class="bi bi-person-x"></i>

                                        Belum ada user.

                                    </td>

                                </tr>

                            <% } else { %>


                                <% users.forEach((user, index) => { %>

                                    <tr>

                                        <!-- NO -->

                                        <td>
                                            <%= index + 1 %>
                                        </td>


                                        <!-- USERNAME -->

                                        <td>

                                            <strong>
                                                <%= user.username %>
                                            </strong>


                                            <% if (
                                                String(user.id) ===
                                                String(currentUser.id)
                                            ) { %>

                                                <span class="badge bg-secondary ms-1">
                                                    Anda
                                                </span>

                                            <% } %>

                                        </td>


                                        <!-- ROLE -->

                                        <td>

                                            <% if (
                                                user.role ===
                                                "Original Gangster"
                                            ) { %>

                                                <span class="badge bg-danger">

                                                    <i class="bi bi-star-fill"></i>

                                                    Original Gangster

                                                </span>


                                            <% } else if (
                                                user.role ===
                                                "Head BuzChef"
                                            ) { %>

                                                <span class="badge bg-warning text-dark">

                                                    <i class="bi bi-shield-fill"></i>

                                                    Head BuzChef

                                                </span>


                                            <% } else if (
                                                user.role ===
                                                "BuzChef"
                                            ) { %>

                                                <span class="badge bg-primary">

                                                    <i class="bi bi-person-badge"></i>

                                                    BuzChef

                                                </span>


                                            <% } else { %>

                                                <span class="badge bg-secondary">

                                                    <i class="bi bi-person"></i>

                                                    Member

                                                </span>

                                            <% } %>

                                        </td>


                                        <!-- AKSI -->

                                        <td>

                                            <!-- ============================ -->
                                            <!-- DIRI SENDIRI -->
                                            <!-- ============================ -->

                                            <% if (
                                                String(user.id) ===
                                                String(currentUser.id)
                                            ) { %>

                                                <span class="text-muted">

                                                    <i class="bi bi-lock"></i>

                                                    Akun sendiri

                                                </span>


                                            <!-- ============================ -->
                                            <!-- ORIGINAL GANGSTER -->
                                            <!-- ============================ -->

                                            <% } else if (
                                                user.role ===
                                                "Original Gangster"
                                            ) { %>

                                                <span class="text-muted">

                                                    <i class="bi bi-lock-fill"></i>

                                                    Dilindungi

                                                </span>


                                            <!-- ============================ -->
                                            <!-- OWNER -->
                                            <!-- ============================ -->

                                            <% } else if (
                                                currentUser.role ===
                                                "Original Gangster"
                                            ) { %>


                                                <div class="d-flex flex-wrap gap-2">


                                                    <!-- ====================== -->
                                                    <!-- MEMBER -->
                                                    <!-- ====================== -->

                                                    <% if (
                                                        user.role ===
                                                        "Member"
                                                    ) { %>


                                                        <!-- MEMBER -> BUZCHEF -->

                                                        <form
                                                            method="POST"
                                                            action="/user/role/<%= user.row %>"
                                                            class="d-inline"
                                                        >

                                                            <input
                                                                type="hidden"
                                                                name="role"
                                                                value="BuzChef"
                                                            >

                                                            <button
                                                                type="submit"
                                                                class="btn btn-sm btn-primary"
                                                            >

                                                                <i class="bi bi-arrow-up"></i>

                                                                BuzChef

                                                            </button>

                                                        </form>


                                                        <!-- MEMBER -> HEAD -->

                                                        <form
                                                            method="POST"
                                                            action="/user/role/<%= user.row %>"
                                                            class="d-inline"
                                                        >

                                                            <input
                                                                type="hidden"
                                                                name="role"
                                                                value="Head BuzChef"
                                                            >

                                                            <button
                                                                type="submit"
                                                                class="btn btn-sm btn-warning"
                                                            >

                                                                <i class="bi bi-arrow-up"></i>

                                                                Head

                                                            </button>

                                                        </form>


                                                    <!-- ====================== -->
                                                    <!-- BUZCHEF -->
                                                    <!-- ====================== -->

                                                    <% } else if (
                                                        user.role ===
                                                        "BuzChef"
                                                    ) { %>


                                                        <!-- BUZCHEF -> MEMBER -->

                                                        <form
                                                            method="POST"
                                                            action="/user/role/<%= user.row %>"
                                                            class="d-inline"
                                                        >

                                                            <input
                                                                type="hidden"
                                                                name="role"
                                                                value="Member"
                                                            >

                                                            <button
                                                                type="submit"
                                                                class="btn btn-sm btn-secondary"
                                                            >

                                                                <i class="bi bi-arrow-down"></i>

                                                                Member

                                                            </button>

                                                        </form>


                                                        <!-- BUZCHEF -> HEAD -->

                                                        <form
                                                            method="POST"
                                                            action="/user/role/<%= user.row %>"
                                                            class="d-inline"
                                                        >

                                                            <input
                                                                type="hidden"
                                                                name="role"
                                                                value="Head BuzChef"
                                                            >

                                                            <button
                                                                type="submit"
                                                                class="btn btn-sm btn-warning"
                                                            >

                                                                <i class="bi bi-arrow-up"></i>

                                                                Head

                                                            </button>

                                                        </form>


                                                    <!-- ====================== -->
                                                    <!-- HEAD -->
                                                    <!-- ====================== -->

                                                    <% } else if (
                                                        user.role ===
                                                        "Head BuzChef"
                                                    ) { %>


                                                        <!-- HEAD -> BUZCHEF -->

                                                        <form
                                                            method="POST"
                                                            action="/user/role/<%= user.row %>"
                                                            class="d-inline"
                                                        >

                                                            <input
                                                                type="hidden"
                                                                name="role"
                                                                value="BuzChef"
                                                            >

                                                            <button
                                                                type="submit"
                                                                class="btn btn-sm btn-primary"
                                                            >

                                                                <i class="bi bi-arrow-down"></i>

                                                                BuzChef

                                                            </button>

                                                        </form>

                                                    <% } %>

                                                    <!-- ====================== -->
                                                    <!-- EDIT -->
                                                    <!-- ====================== -->

                                                    <a
                                                        href="/user/edit/<%= user.row %>"
                                                        class="btn btn-sm btn-info text-white"
                                                    >
                                                        <i class="bi bi-pencil"></i>
                                                        Edit
                                                    </a>

                                                    <!-- ====================== -->
                                                    <!-- HAPUS -->
                                                    <!-- ====================== -->

                                                    <form
                                                        method="POST"
                                                        action="/user/delete/<%= user.row %>"
                                                        class="d-inline"
                                                        onsubmit="return confirm('Yakin ingin menghapus user <%= user.username %>?')"
                                                    >

                                                        <button
                                                            type="submit"
                                                            class="btn btn-sm btn-danger"
                                                        >

                                                            <i class="bi bi-trash"></i>

                                                            Hapus

                                                        </button>

                                                    </form>



                                                </div>


                                            <!-- ============================ -->
                                            <!-- HEAD BUZCHEF -->
                                            <!-- ============================ -->

                                            <% } else if (
                                                currentUser.role ===
                                                "Head BuzChef"
                                            ) { %>


                                                <% if (
                                                    user.role ===
                                                    "Member"
                                                ) { %>


                                                    <form
                                                        method="POST"
                                                        action="/user/role/<%= user.row %>"
                                                        class="d-inline"
                                                    >

                                                        <input
                                                            type="hidden"
                                                            name="role"
                                                            value="BuzChef"
                                                        >

                                                        <button
                                                            type="submit"
                                                            class="btn btn-sm btn-primary"
                                                        >

                                                            <i class="bi bi-arrow-up"></i>

                                                            Promote BuzChef

                                                        </button>

                                                    </form>


                                                <% } else { %>

                                                    <span class="text-muted">

                                                        Tidak ada akses

                                                    </span>

                                                <% } %>


                                            <!-- ============================ -->
                                            <!-- BUZCHEF / MEMBER -->
                                            <!-- ============================ -->

                                            <% } else { %>

                                                <span class="text-muted">

                                                    <i class="bi bi-lock"></i>

                                                    Tidak ada akses

                                                </span>

                                            <% } %>

                                        </td>

                                    </tr>

                                <% }) %>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>


<%- include("../layouts/data") %>

<%- include("../layouts/footer") %>